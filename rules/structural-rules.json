  "rules": [
    {
      "id": "unprompted-popup",
      "category": "Nagging",
      "approach": "Pop-up Interruption",
      "mechanism": "Repeated interruption",
      "severity": "medium",
      "explanation": "A pop-up opened on its own — you didn't click anything to bring it up. Interrupting you mid-browse grabs your attention at a moment you're not ready to think it over. It's fine to close it and carry on."
    },
    {
      "id": "biased-buttons",
      "category": "Interface Interference",
      "approach": "Biased Buttons",
      "mechanism": "Visual misdirection / false hierarchy",
      "severity": "medium",
      "settles": ["biased-cookie-choices"],
      "explanation": "The answer the site wants is big and bright, while the option to say no is smaller, greyer or harder to spot. Both answers are equally valid — the styling is nudging you toward one of them."
    },
    {
      "id": "preticked-addon",
      "category": "Sneaking",
      "approach": "Pre-ticked Add-on",
      "mechanism": "Sneaking / pre-selection",
      "severity": "high",
      "explanation": "An optional extra was already ticked for you. If you leave it, it will probably be added to your order and your total — untick it if you don't want it."
    },
    {
      "id": "hidden-cancel-link",
      "category": "Obstruction",
      "approach": "Hidden Cancel Link",
      "mechanism": "Cognitive obstruction",
      "severity": "high",
      "explanation": "The way out — cancelling or unsubscribing — is on the page, but styled so it is easy to miss: tiny, faint, or both. Joining was made easy; leaving is made easy to overlook."
    },
    {
      "id": "preticked-consent",
      "category": "Interface Interference",
      "approach": "Pre-ticked Opt-in",
      "mechanism": "Default opt-in / pre-selection",
      "severity": "medium",
      "explanation": "A box agreeing to marketing or sharing your details was ticked before you got here. Leaving it means you've 'agreed' without actually choosing to — untick it if you don't want this."
    }
  ]
}
